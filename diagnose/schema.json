{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$id": "https://github.com/cstimkong/diagnose/blob/main/diagnose/schema.json",
    "title": "Dynamic Object Relation Graph",
    "description": "Format of Dynamic Object Relation Graph",
    "type": "object",
    "definitions": {
        "nodeRef": {
            "oneOf": [
                {
                    "properties": {
                        "nodeId": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                {
                    "properties": {
                        "nativeObject": {
                            "type": "string"
                        }
                    }
                },
                {
                    "properties": {
                        "nativeType": {
                            "type": "string"
                        }
                    }
                }
            ]
        },
        "node": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "number",
                    "minimum": 0
                },
                "createdFromNodeId": {
                    "type": "number",
                    "minimum": -1
                }
            },
            "oneOf": [
                {
                    "properties": {
                        "nodeType": {
                            "oneOf": [
                                {
                                    "const": "object"
                                },
                                {
                                    "const": "start"
                                }
                            ]
                        },
                        "edges": {
                            "type": "array",
                            "items": {
                                "oneOf": [
                                    {
                                        "$ref": "#/definitions/callEdge"
                                    },
                                    {
                                        "$ref": "#/definitions/ownPropEdge"
                                    }
                                ]
                            }
                        }
                    }
                },
                {
                    "properties": {
                        "nodeType": {
                            "const": "type"
                        },
                        "edges": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/hasPropEdge"
                            }
                        }
                    }
                }
            ]
        },
        "ownPropEdge": {
            "type": "object",
            "properties": {
                "propName": {
                    "type": "string"
                },
                "edgeType": {
                    "const": "hasProp"
                },
                "target": {
                    "$ref": "#/definitions/nodeRef"
                }
            }
        },
        "hasPropEdge": {
            "type": "object",
            "properties": {
                "propName": {
                    "type": "string"
                },
                "edgeType": {
                    "const": "hasProp"
                },
                "target": {
                    "$ref": "#/definitions/nodeRef"
                }
            }
        },
        "callEdge": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "object",
                    "properties": {
                        "this": {
                            "type": "string"
                        },
                        "arguments": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "target": {
                    "$ref": "#/definitions/nodeRef"
                }
            }
        }
    },
    "properties": {
        "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/node"
            }
        }
    }
}